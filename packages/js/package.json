{
  "name": "strata-packages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./ui/src/**/*.css"
  ],
  "exports": {
    "./ui/theme.css": "./ui/src/theme.css",
    "./ui/utils": "./ui/src/utils.ts",
    "./ui/*": {
      "types": "./ui/src/components/*/index.ts",
      "default": "./ui/src/components/*/index.ts"
    },
    "./ui-interactions/*": {
      "types": "./ui-interactions/src/*.ts",
      "default": "./ui-interactions/src/*.ts"
    },
    "./inertia-plus": {
      "types": "./inertia-plus/src/index.ts",
      "default": "./inertia-plus/src/index.ts"
    }
  },
  "scripts": {
    "quality:check": "npm run typecheck:ui && npm run typecheck:ui-interactions && npm run typecheck:inertia-plus && npm run typecheck:extension-reloader && npm run test:ui-interactions && npm run test:inertia-plus && npm run test:extension-reloader",
    "quality:fix": "npm run quality:check",
    "typecheck:extension-reloader": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext extension-reloader/index.ts",
    "test:extension-reloader": "node --test extension-reloader/tests/*.test.ts",
    "typecheck:ui": "vue-tsc --noEmit -p ui/tsconfig.json",
    "typecheck:ui-interactions": "tsc --noEmit -p ui-interactions/tsconfig.json",
    "typecheck:inertia-plus": "tsc --noEmit -p inertia-plus/tsconfig.json",
    "test:ui-interactions": "node --test ui-interactions/tests/*.test.ts",
    "test:inertia-plus": "node --test inertia-plus/tests/*.test.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.24.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul-vue": "^0.4.1",
    "vue-input-otp": "^0.1.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.6.1",
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.40",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^2.2.12"
  }
}
