<idea-plugin>
    <id>strata.ide.integration</id>
    <name>Strata IDE Integration</name>
    <vendor>Strata</vendor>
    <description>Compact HTML and Vue class lists and ARIA attribute values, with hover controls for native HTML element folds.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Strata" anchor="right" icon="AllIcons.Nodes.Plugin"
                    factoryClass="strata.ide.ui.StrataToolWindowFactory"/>
        <editorFactoryListener implementation="strata.ide.folding.CollapsibleHtmlClasses$FactoryListener"/>
        <editorFactoryListener implementation="strata.ide.folding.CollapsibleHtmlAria$FactoryListener"/>
        <editorFactoryListener implementation="strata.ide.folding.CollapsibleHtmlElements$FactoryListener"/>
        <!-- Vue inherits HTML folding; register here to preserve native template folds. -->
        <lang.foldingBuilder language="HTML" implementationClass="strata.ide.folding.CollapsibleHtmlClasses$FoldingBuilder"/>
        <lang.foldingBuilder language="HTML" implementationClass="strata.ide.folding.CollapsibleHtmlAria$FoldingBuilder"/>
    </extensions>
</idea-plugin>
